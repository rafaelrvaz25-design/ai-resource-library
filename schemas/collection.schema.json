{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaelrvaz25-design/ai-resource-library/schemas/collection.schema.json",
  "title": "Collection",
  "description": "Coleção temática. Contém apenas referências (IDs) a recursos do catálogo, nunca os metadados completos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "goals", "use_cases", "categories", "tags", "resources", "updated_on"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "goals": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "use_cases": { "type": "array", "items": { "type": "string" } },
    "categories": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "rationale"],
        "properties": {
          "id": { "type": "string" },
          "role": { "enum": ["core", "recommended", "optional", "alternative", "reference", "avoid"] },
          "rationale": { "type": "string", "minLength": 10 }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "prefer", "why"],
        "properties": {
          "scenario": { "type": "string" },
          "prefer": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "consider": { "type": "array", "items": { "type": "string" } },
          "why": { "type": "string" }
        }
      }
    },
    "updated_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "ext": { "type": "object" }
  }
}
